# Self-Healing MLOps Agent — 환경변수 템플릿
# 이 파일을 복사해서 .env 로 저장 후 실제 값을 채우세요.
# cp .env.example .env

# ── 필수: Groq (LLM L2 추론 — 1순위) ───────────────────────────────────
# https://console.groq.com/keys 에서 발급 (무료 tier 제공)
# 설정되어 있으면 L2 추론 1순위로 사용되고, 미설정/실패 시 Ollama → Rule-based로
# 자동 폴백된다(폴백 자체는 되지만, Groq 없이는 L2 정확도가 크게 떨어진다).
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MAX_RETRIES=2
# GROQ_RETRY_BASE_SEC=2.0

# ── 필수: Telegram (ChatOps 승인 요청·장애 알림 — Slack보다 우선 사용됨) ──
# 1. @BotFather에게 /newbot 으로 봇 생성 → 토큰 발급
# 2. 그 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 로 chat_id 확인
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── 선택: GitHub (ETL 크롤러 — 희소 카테고리 데이터 보강 시에만 필요) ────
# https://github.com/settings/tokens → public_repo 권한만 필요. 없어도
# 미인증 API 폴백으로 동작하지만 레이트리밋이 훨씬 낮다.
# GITHUB_TOKEN=ghp_your_github_token_here

# ── 선택: Slack (Telegram 미설정 시에만 폴백으로 사용되는 경보 채널) ─────
# https://api.slack.com/apps → Incoming Webhooks 활성화 후 URL 복사
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/xxxxxxxxxxxxxxxxxxxxxxxx

# ── ChromaDB ─────────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False

# ── Ollama (LLM L2 추론 — Groq 미설정/실패 시 폴백) ────────────────────
# 로컬 실행: http://localhost:11434 (기본값)
# Docker Compose 실행: http://ollama:11434
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_MAX_RETRIES=3          # 연결 실패 시 재시도 횟수 (기본 3)
# OLLAMA_RETRY_BASE_SEC=2.0     # 재시도 대기 밑수: 2s → 4s → 8s

# ── 테스트/CI 전용 — 운영에선 쓰지 않음 ───────────────────────────────
# Progressive Autonomy(카테고리별 autonomy_store, README 참고)가 운영 중
# 승인 여부를 결정한다 — AUTO_APPROVE는 그것과 별개로 테스트/실험 스크립트가
# 승인 대기 없이 끝까지 돌게 하는 하드 바이패스다. 운영 서버의 .env에는
# 이 값을 설정하지 말 것(설정하면 승인 게이트 자체가 무의미해진다).
# AUTO_APPROVE=true

# ── 경로 설정 (Docker 환경에서는 보통 변경 불필요) ───────────────────
# DATA_DIR=/app/data
# LOG_FILE=/app/data/realtime_system.log

# ── 서버 설정 (config/servers.yaml, 2026-09-06 추가) ──────────────────
# 여러 서버를 등록해뒀다면(예: gcp-primary/local-minikube/gcp-k3s) 이
# TARGET_SERVER로 이 서버가 어떤 걸 쓸지 선택한다 — 미설정 시 목록의 첫
# 서버(기본: gcp-primary, exec_method: systemd)가 쓰인다.
# TARGET_SERVER=gcp-primary
# TARGET_URL=http://localhost:9000   # scripts/chaos_cron.sh가 읽는 타겟앱 주소
#                                     # (servers.yaml이 없을 때만 쓰이는 폴백)

# ── 카오스 엔지니어링 장애 주입 (scripts/chaos_cron.sh) ───────────────
# CHAOS_ENABLED=true  : cron이 주기적으로 target-app에 실제 장애(OOM/CPU/디스크/프로세스 kill) 주입
# CHAOS_ENABLED=false : cron이 실행돼도 즉시 종료 (킬 스위치)
CHAOS_ENABLED=true
