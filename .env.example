# Self-Healing MLOps Agent — 환경변수 템플릿
# 이 파일을 복사해서 .env 로 저장 후 실제 값을 채우세요.
# cp .env.example .env

# ── GitHub (ETL 크롤러용) ──────────────────────────────────────────────
# https://github.com/settings/tokens → public_repo 권한만 필요
GITHUB_TOKEN=ghp_your_github_token_here

# ── Slack (에러/Circuit Breaker 알림) ────────────────────────────────
# https://api.slack.com/apps → Incoming Webhooks 활성화 후 URL 복사
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXXXX/XXXXXXXXX/xxxxxxxxxxxxxxxxxxxxxxxx

# ── ChromaDB ─────────────────────────────────────────────────────────
ANONYMIZED_TELEMETRY=False

# ── Groq (LLM L2 추론 — 1순위) ─────────────────────────────────────────
# https://console.groq.com/keys 에서 발급 (무료 tier 제공)
# 설정되어 있으면 L2 추론 1순위로 사용되고, 미설정/실패 시 Ollama로 자동 폴백된다.
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.6-27b   # 2026-08 기준 Groq 가용 모델. llama-3.3-70b-versatile는 단종됨
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_MAX_RETRIES=2
# GROQ_RETRY_BASE_SEC=2.0

# ── Ollama (LLM L2 추론 — Groq 미설정/실패 시 폴백) ────────────────────
# 로컬 실행: http://localhost:11434 (기본값)
# Docker Compose 실행: http://ollama:11434
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_MAX_RETRIES=3          # 연결 실패 시 재시도 횟수 (기본 3)
# OLLAMA_RETRY_BASE_SEC=2.0     # 재시도 대기 밑수: 2s → 4s → 8s

# ── Human-in-the-Loop 승인 모드 ───────────────────────────────────────
# AUTO_APPROVE=true   : 모든 LLM 명령 자동 승인 (테스트/신뢰 환경 전용)
# AUTO_APPROVE=false  : 인터랙티브 터미널이면 y/n 입력, 데몬이면 Slack 알림 후 에스컬레이션
# AUTO_APPROVE=false

# ── 경로 설정 (Docker 환경에서는 보통 변경 불필요) ───────────────────
# DATA_DIR=/app/data
# LOG_FILE=/app/data/realtime_system.log

# ── 서버 설정 (config/servers.yaml, 2026-09-06 추가) ──────────────────
# 지금은 서버가 1대뿐이라 config/servers.yaml에 직접 채워두면 되고, 아래
# 값들은 그 파일이 없을 때만 쓰이는 폴백/개별 스크립트용 오버라이드다.
# TARGET_URL=http://localhost:9000   # scripts/chaos_cron.sh가 읽는 타겟앱 주소

# ── 카오스 엔지니어링 장애 주입 (scripts/chaos_cron.sh) ───────────────
# CHAOS_ENABLED=true  : cron이 주기적으로 target-app에 실제 장애(OOM/CPU/디스크/프로세스 kill) 주입
# CHAOS_ENABLED=false : cron이 실행돼도 즉시 종료 (킬 스위치)
CHAOS_ENABLED=true
